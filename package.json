{
  "name": "bpmn-di-gen",
  "version": "0.1.0",
  "description": "Generate readable BPMN Diagram Interchange information for BPMN 2.0 XML.",
  "author": "Chris",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ultimatechris/bpmn-di-gen.git"
  },
  "homepage": "https://github.com/ultimatechris/bpmn-di-gen#readme",
  "bugs": {
    "url": "https://github.com/ultimatechris/bpmn-di-gen/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "bpmn-di-gen": "dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "docs/support-matrix.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm test",
    "pretest": "npm run build",
    "test": "vitest run --dir test",
    "test:watch": "vitest --dir test",
    "check": "npm test",
    "setup:test-browser": "playwright install firefox",
    "test:visual:update": "npm run build && node scripts/update-visual-baselines.mjs"
  },
  "keywords": [
    "bpmn",
    "bpmn2",
    "bpmndi",
    "diagram-interchange",
    "auto-layout",
    "layout",
    "swimlanes",
    "process-mining",
    "camunda",
    "flowable",
    "activiti"
  ],
  "license": "MIT",
  "dependencies": {
    "bpmn-moddle": "^9.0.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "bpmn-js": "^18.18.0",
    "playwright": "^1.61.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
